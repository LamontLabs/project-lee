modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
CIL_LEE_ENDPOINT = "https://cognitive-infrastructure-layer.replit.app/api/query/lee"
CERBASEAL_BASE_URL = "https://cerbaseal.replit.app"
CERBASEAL_POLICY_PACK_VERSION = "2026.7.1"
CERBASEAL_EVALUATE_ENDPOINT = "https://cerbaseal.replit.app/evaluate"
CERBASEAL_POLICY_VERSION_ENDPOINT = "https://cerbaseal.replit.app/policy/current-version"
CERBASEAL_HEALTH_ENDPOINT = "https://cerbaseal.replit.app/health"
CIL_HEALTH_ENDPOINT = "/api/health"
LEE_CIL_PROJECT_ID = "cil-project"
MCP_PROJECTS_JSON = """
[
  {
    \"id\": \"cil-project\",
    \"name\": \"Cognitive Infrastructure Layer\",
    \"endpoint\": \"https://cognitive-infrastructure-layer.replit.app\",
    \"tokenEnv\": \"CIL_API_KEY\",
    \"adapter\": \"replit-standard\",
    \"capabilityLevel\": \"MANAGE\",
    \"capabilities\": [
      \"inspect\",
      \"search\",
      \"read\",
      \"dependencies\",
      \"logs\",
      \"contract\",
      \"check\",
      \"preview\",
      \"apply\",
      \"restart\"
    ]
  }
]"""

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]
