{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:manifest": "node --test scripts/manifest-contract.test.mjs",
    "test:behavioral": "node --test scripts/behavioral-test-foundation.test.mjs",
    "test:pipeline": "node --test scripts/request-pipeline.test.mjs",
    "test:internal-security": "node --test scripts/internal-route-security.test.mjs",
    "test:event-replay": "node --test scripts/event-replay.test.mjs",
    "test:backup-restore": "node --test scripts/backup-restore.test.mjs",
    "test:event-delivery": "node scripts/event-delivery.test.mjs",
    "test:consequential-execution": "node scripts/consequential-execution.test.mjs",
    "test:cil-protocol": "node scripts/cil-protocol.test.mjs",
    "test:cil-cost-benchmark": "node scripts/cil-cost-benchmark.test.mjs",
    "test:provider-boundary": "node --test scripts/provider-boundary.test.mjs",
    "test:project-bootstrap": "node scripts/project-bootstrap.test.mjs",
    "test:query-architecture": "node --test scripts/query-engine-architecture.test.mjs",
    "test:ledger-boundary": "node --test scripts/ledger-boundary-hostile.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
