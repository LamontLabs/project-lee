{
  "name": "@workspace/lee-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project LEE Windows desktop shell and local runtime supervisor.",
  "author": {
    "name": "Lamont Labs",
    "email": "noreply@lamontlabs.com"
  },
  "desktopName": "project-lee",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamontlabs/project-lee"
  },
  "build": {
    "executableName": "Project-LEE",
    "productName": "Project LEE"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "package": "pnpm run build && node scripts/prepare-runtime.mjs && electron-builder --config electron-builder.yml --publish never",
    "smoke:unix": "node scripts/unix-runtime-smoke.mjs",
    "test:runtime-contract": "node --test scripts/desktop-runtime-contract.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}