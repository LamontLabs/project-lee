{
  "name": "@workspace/lee-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "package": "pnpm run build && node scripts/prepare-runtime.mjs && electron-builder --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron": "^38.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "tsx": "catalog:"
  }
}